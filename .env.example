# Backend URL
VITE_API_URL=http://localhost:3000

# Sepolia. Completar con valores en .env de backend.
VITE_RPC_URL=completar_con_alchemy_instructivo_en_repo_blockchain
VITE_CHAIN_ID=11155111
VITE_VOTE_TRANSMITTER_PRIVATE_KEY=private_key
VITE_AUDIT_VIEW_ADDRESS=multisig_address

#               #
#   OPCIONALES  #
#               #

# Requerida por el verificador público de voto (VOTAR-366).
# Obtener ejecutando: npx ts-node scripts/init-sepolia-contracts/inspect-election.ts <ELECTION_ID>
# en el repo blockchain, una vez que haya al menos un comicio creado y oficializado.
#VITE_BALLOT_CONTRACT_ADDRESS=

# Dirección del ElectionFactory (VOTAR-439). Cada comicio despliega su propio
# BallotContract vía ElectionFactory, por lo que la verificación pública de un
# recibo valida contra esta dirección en lugar de un único BallotContract fijo.
#VITE_ELECTION_FACTORY_ADDRESS=